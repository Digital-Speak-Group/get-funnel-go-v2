# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/getfunnels?schema=public"
# Optional. Unset: SSL on unless the host is localhost. Set "false" for a private-network DB without TLS.
# DATABASE_SSL="false"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth
AUTH_SECRET="your-auth-secret-min-32-chars"

# AI (Groq). Model ids must be listed by GET https://api.groq.com/openai/v1/models for your key.
GROQ_API_KEY="gsk_..."
AI_MODEL_FAST="openai/gpt-oss-20b"
AI_MODEL_QUALITY="openai/gpt-oss-120b"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend
RESEND_API_KEY="re_..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PDF export (optional). By default the installed Chrome or Edge is found automatically.
# CHROMIUM_EXECUTABLE_PATH="/usr/bin/chromium"       # VPS/Docker: path to Chrome or Chromium
# CHROMIUM_PACK_URL="https://.../chromium-pack.tar"  # serverless only (@sparticuz/chromium-min)

# Seed (dev only)
SEED_DEMO_PASSWORD="demo-password-123"
# Opt-in DB integration tests (rls, onboarding). Must be a DISPOSABLE database, never
# DATABASE_URL: the RLS suite migrates it and truncates every table.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/getfunnels_test"
# Playwright e2e credentials (test-only account)
E2E_EMAIL=
E2E_PASSWORD=
