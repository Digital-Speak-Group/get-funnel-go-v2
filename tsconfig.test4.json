{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "allowJs": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true
  },
  "include": ["minimal6.tsx"]
}
